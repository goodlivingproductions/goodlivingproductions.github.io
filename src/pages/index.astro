---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const home = await getEntry('pages', 'home');

if (!home) {
  throw new Error('Home page content could not be found.');
}

const { Content } = await render(home);
---

<PageLayout
  title={home.data.title}
  description={home.data.description}
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Good Living Productions</p>

      <h1>Music. Production. Performance.</h1>

      <div class="intro">
        <Content />
      </div>

      <a class="button" href="/work/">
        Explore Our Work
      </a>
    </div>
  </section>
</PageLayout>

<style>
  .hero {
    min-height: min(80vh, 850px);
    display: flex;
    align-items: center;
  }

  .hero-inner {
    padding-block: 7rem;
  }

  .eyebrow {
    margin-bottom: 2rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 900px;
    margin-bottom: 2.5rem;
    font-weight: 500;
  }

  .intro {
    max-width: 650px;
    margin-bottom: 2.5rem;
  }

  .intro :global(p) {
    margin: 0;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.6;
  }

  .intro :global(h2) {
    display: none;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--color-text);
    color: var(--color-text);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .button:hover {
    background: var(--color-text);
    color: var(--color-background);
  }

  @media (max-width: 640px) {
    .hero-inner {
      padding-block: 5rem;
    }
  }
</style>