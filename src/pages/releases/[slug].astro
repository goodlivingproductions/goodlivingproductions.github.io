---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

export async function getStaticPaths() {
  const releases = await getCollection('releases');

  return releases.map((release) => ({
    params: { slug: release.id },
    props: { release },
  }));
}

const { release } = Astro.props;
const { Content } = await render(release);

const {
  title,
  artist,
  description,
  cover,
  releaseDate,
} = release.data;

const formattedDate = releaseDate
  ? releaseDate.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : undefined;
---

<PageLayout
  title={`${title} — ${artist}`}
  description={description}
  image={cover}
>
  <article class="release-page">
    <section class="release-header">
      <div class="container release-header-inner">
        {cover && (
          <div class="release-cover">
            <img
              src={cover}
              alt={`${title} by ${artist}`}
            />
          </div>
        )}

        <div class="release-intro">
          <p class="eyebrow">Release</p>

          <h1>{title}</h1>

          <p class="artist">{artist}</p>

          {formattedDate && (
            <time datetime={releaseDate?.toISOString()}>
              {formattedDate}
            </time>
          )}
        </div>
      </div>
    </section>

    <section class="release-content">
      <div class="container content-grid">
        <div class="content">
          <Content />
        </div>
      </div>
    </section>
  </article>
</PageLayout>

<style>
  .release-header {
    padding-block: 7rem;
    border-bottom: 1px solid var(--color-border);
  }

  .release-header-inner {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) 1.2fr;
    gap: 5rem;
    align-items: center;
  }

  .release-cover {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .release-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .eyebrow {
    margin-bottom: 1.5rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .artist {
    margin-bottom: 0.5rem;
    color: var(--color-text);
    font-size: 1.25rem;
  }

  time {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .release-content {
    padding-block: 6rem 8rem;
  }

  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 800px);
    justify-content: center;
  }

  .content :global(h2) {
    margin-top: 4rem;
    margin-bottom: 1.5rem;
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 500;
  }

  .content :global(h3) {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .content :global(p) {
    margin-bottom: 1.5rem;
    font-size: 1.1rem;
  }

  .content :global(ul) {
    padding-left: 1.25rem;
    color: var(--color-text-muted);
  }

  .content :global(li) {
    margin-bottom: 0.5rem;
  }

  .content :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 750px) {
    .release-header {
      padding-block: 5rem;
    }

    .release-header-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .release-cover {
      max-width: 500px;
    }

    .release-content {
      padding-block: 5rem;
    }
  }
</style>