---
import { site } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={site.name}>
      <span class="brand-main">GOOD LIVING</span>
      <span class="brand-sub">PRODUCTIONS</span>
    </a>

    <nav aria-label="Main navigation">
      <ul class="nav-list">
        {site.navigation.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={{ active: currentPath.startsWith(item.href) }}
              aria-current={
                currentPath.startsWith(item.href) ? 'page' : undefined
              }
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    min-height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
    flex-shrink: 0;
  }

  .brand-main {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .brand-sub {
    margin-top: 0.3rem;
    color: var(--color-text-muted);
    font-size: 0.55rem;
    font-weight: 500;
    letter-spacing: 0.28em;
  }

  nav {
    margin-left: auto;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .nav-list a {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 160ms ease;
  }

  .nav-list a:hover,
  .nav-list a.active {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .header-inner {
      min-height: auto;
      padding-block: 1.25rem;
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      margin-left: 0;
      width: 100%;
      overflow-x: auto;
    }

    .nav-list {
      width: max-content;
    }
  }
</style>