---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="page-header">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>

    <h1>{title}</h1>

    {intro && <p class="intro">{intro}</p>}

    <slot />
  </div>
</section>

<style>
  .page-header {
    padding-block: 8rem 6rem;
  }

  .eyebrow {
    margin-bottom: 2rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 950px;
    margin-bottom: 2rem;
    font-weight: 500;
  }

  .intro {
    max-width: 700px;
    margin-bottom: 0;
    font-size: 1.2rem;
  }

  @media (max-width: 640px) {
    .page-header {
      padding-block: 5rem 4rem;
    }
  }
</style>